services:
    tor:
        image: lnliz/tor:v0.4.9.15
        container_name: tor
        ports:
            - "127.0.0.1:9050:9050"
        volumes:
            - ./torrc:/etc/tor/torrc:ro
            - tor-data:/var/lib/tor
            - tor-control:/var/run/tor
        restart: on-failure
        stop_grace_period: 10m30s

volumes:
    tor-data:
    tor-control:
